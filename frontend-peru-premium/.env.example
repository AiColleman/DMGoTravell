# ============================================================================
# DMGOTRAVEL · Viajes Perú Premium — Configuración Pública Frontend (ADR-012 / ADR-014)
# IMPORTANTE (RS02 / C4 Nivel 2): NUNCA colocar claves secretas de servidor en variables VITE_*
# ============================================================================

# Producción en Vercel Edge/CDN -> apunta al perímetro Cloudflare Proxy/WAF (https://api.dmgotravel.com)
# Desarrollo local -> dejar vacío para usar el proxy de Vite (/api, /health, /openapi -> http://localhost:5194)
VITE_API_BASE_URL=

# Destino del Monolito Modular ASP.NET Core en desarrollo local
VITE_DEV_PROXY_TARGET=http://localhost:5194

# Clave pública de Culqi Checkout v4 (pk_test_... o pk_live_...). Si está vacía usa tokenizador sandbox local (AC11)
VITE_CULQI_PUBLIC_KEY=

# Inicio del flujo Google OAuth 2.0 / OpenID Connect gestionado por ASP.NET Core Identity (ADR-009 / RC13)
VITE_GOOGLE_OAUTH_START_URL=/api/v1/auth/google/start

# Referencia pública del contrato OpenAPI 3.1 expuesto por el backend (ADR-015)
VITE_OPENAPI_SPEC_URL=/openapi/v1.yaml
