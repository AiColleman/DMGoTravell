{
  "name": "dmgotravel-frontend",
  "private": true,
  "version": "1.0.0",
  "description": "Plataforma web empresarial DMGOTRAVEL (React + TypeScript + Vite) conectada al Monolito Modular ASP.NET Core 10.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
