# Entorno y Configuración Local - DMGOTRAVEL
ASPNETCORE_ENVIRONMENT=Development

# Base de Datos PostgreSQL
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=dmgotravel_dev;Username=dmgotravel_user;Password=dmgotravel_password_2026

# Seguridad y Autenticación JWT (RS256; en Development se genera App_Data/dev-jwt-key.pem)
Jwt__Issuer=DMGoTravel.Api
Jwt__Audience=DMGoTravel.Client
Jwt__AccessTokenMinutes=5

# Google OAuth 2.0 (Desarrollo / Sandbox)
Google__ClientId=your-google-client-id.apps.googleusercontent.com
Google__ClientSecret=your-google-client-secret

# Pasarela de Pagos Culqi
Culqi__PublicKey=pk_test_sample_key
Culqi__PrivateKey=sk_test_sample_key
Culqi__WebhookSecret=whsec_sample_secret

# Envío de Correos Resend
Resend__ApiKey=re_sample_api_key
Resend__FromEmail=notificaciones@dmgotravel.com

# Almacenamiento Cloudflare R2 (S3-compatible)
R2__AccountId=sample_account_id
R2__AccessKeyId=sample_access_key
R2__SecretAccessKey=sample_secret_key
R2__BucketName=dmgotravel-media
R2__PublicBaseUrl=https://media.dmgotravel.com
